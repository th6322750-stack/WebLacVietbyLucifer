{
  "revision": "phuong-an-2026-09-07",
  "entities": {
    "Service": {
      "required": [
        "slug",
        "category",
        "title",
        "summary",
        "ctaLabel",
        "group",
        "routeMode",
        "policyClass",
        "published",
        "claimState"
      ],
      "optional": [
        "features",
        "priceMode",
        "priceVnd",
        "heroAssetId",
        "faqIds",
        "navHidden",
        "featuredOnHome",
        "navOrder",
        "relatedSlugs",
        "verifiedAt",
        "disclosure"
      ],
      "rules": [
        "priceMode in fixed|from|contact|hidden",
        "production pricing requires verification",
        "policyClass 'excluded' không bao giờ vào luồng publish, dù published = true",
        "publish và có mặt trong menu là hai quyết định tách rời (navHidden)"
      ]
    },
    "Project": {
      "required": [
        "slug",
        "title",
        "category",
        "summary",
        "demoOnly"
      ],
      "optional": [
        "heroAssetId",
        "challenge",
        "solution",
        "results",
        "technology",
        "galleryAssetIds"
      ],
      "rules": [
        "demoOnly projects cannot become factual client claims"
      ]
    },
    "Article": {
      "required": [
        "slug",
        "title",
        "category",
        "excerpt",
        "content",
        "publishedAt",
        "author"
      ],
      "optional": [
        "coverAssetId",
        "readMinutes",
        "seoTitle",
        "seoDescription"
      ],
      "rules": [
        "content must support heading IDs for TOC"
      ]
    },
    "FAQ": {
      "required": [
        "id",
        "scope",
        "question",
        "answer",
        "order"
      ]
    },
    "Lead": {
      "required": [
        "name",
        "phone",
        "need",
        "service",
        "preferredChannel",
        "consent",
        "sourceRoute",
        "createdAt"
      ],
      "optional": [
        "email",
        "utm",
        "referrer"
      ],
      "rules": [
        "phone required",
        "consent required",
        "PII never embedded into analytics event payload"
      ]
    },
    "Subscriber": {
      "required": [
        "email",
        "consent",
        "createdAt"
      ],
      "optional": [
        "sourceRoute"
      ]
    },
    "SiteSettings": {
      "required": [
        "brandName",
        "slogan",
        "domain",
        "zalo",
        "telegram"
      ],
      "optional": [
        "facebookUrl",
        "email",
        "address"
      ]
    },
    "PricingPackage": {
      "required": [
        "id",
        "groupId",
        "plan",
        "priceLabel",
        "published",
        "claimState"
      ],
      "optional": [
        "priceVnd",
        "description",
        "features",
        "featured",
        "sortOrder",
        "verifiedAt",
        "disclosure"
      ],
      "rules": [
        "Không giá gạch ngang, % giảm, thời gian bàn giao hay bảo hành trọn đời"
      ]
    },
    "Testimonial": {
      "required": [
        "id",
        "authorName",
        "quote",
        "published",
        "claimState"
      ],
      "optional": [
        "authorRole",
        "company",
        "serviceSlug",
        "avatarAssetId",
        "verifiedAt",
        "disclosure"
      ],
      "rules": [
        "Chỉ hiện khi claimState = 'verified' VÀ có verification_evidence",
        "Không có trạng thái 'demo' hợp lệ: đăng lời khen minh hoạ kèm tên người là bịa phát ngôn của người khác"
      ]
    },
    "Metric": {
      "required": [
        "id",
        "scope",
        "label",
        "valueLabel",
        "published",
        "claimState"
      ],
      "optional": [
        "method",
        "measuredAt",
        "verifiedAt",
        "disclosure"
      ],
      "rules": [
        "method in measured|counted|estimated",
        "method 'estimated' không bao giờ được coi là 'verified', dù đã bấm duyệt"
      ]
    },
    "TrustMark": {
      "required": [
        "id",
        "name",
        "relationship",
        "published",
        "claimState"
      ],
      "optional": [
        "logoAssetId",
        "evidenceId",
        "verifiedAt",
        "disclosure"
      ],
      "rules": [
        "relationship in platform-used|certified-partner|client|media-mention",
        "certified-partner / client / media-mention BẮT BUỘC có verification_evidence mới hiện",
        "Logo nền tảng không bao giờ được gọi là 'đối tác'"
      ]
    },
    "DigitalOffer": {
      "required": [
        "id",
        "brand",
        "name",
        "priceLabel",
        "published",
        "claimState"
      ],
      "optional": [
        "priceVnd",
        "features",
        "verifiedAt",
        "disclosure"
      ],
      "rules": [
        "Không cam kết bảo hành hay SLA khi chưa có quy trình vận hành thật"
      ]
    },
    "VerificationEvidence": {
      "required": [
        "id",
        "subjectType",
        "subjectId",
        "kind",
        "verifiedBy",
        "verifiedAt"
      ],
      "optional": [
        "note",
        "assetId",
        "sourceUrl"
      ],
      "rules": [
        "kind in contract|invoice|screenshot|analytics-export|written-consent|other",
        "verifiedBy lấy từ phiên đăng nhập, không bao giờ từ payload của client",
        "note bắt buộc khi duyệt qua giao diện admin"
      ]
    }
  },
  "apiBehavior": {
    "leadSubmit": {
      "method": "POST",
      "pathSuggestion": "/api/leads",
      "success": "2xx + stable receipt id",
      "validation": "4xx field errors",
      "serverFailure": "5xx generic user-safe message"
    },
    "newsletterSubscribe": {
      "method": "POST",
      "pathSuggestion": "/api/newsletter",
      "success": "2xx",
      "duplicate": "idempotent success or clear already-subscribed state"
    }
  },
  "crmFutureProofing": "Persist external_sync_status + external_id fields or equivalent adapter metadata so Agency OS/CRM integration can be added without changing public form contract.",
  "uploadStorage": {
    "interface": "src/lib/uploads/adapter.ts — UploadAdapter",
    "current": "LocalDiskAdapter (public/assets/uploads)",
    "blocker": "KHÔNG hoạt động trên Vercel: filesystem serverless là ephemeral, tệp tải lên sẽ mất trong khi hàng trong bảng assets vẫn còn — trang công khai trỏ tới tệp 404. Cần chọn Vercel Blob, S3/R2, hoặc bỏ hẳn chức năng upload trên production."
  }
}
