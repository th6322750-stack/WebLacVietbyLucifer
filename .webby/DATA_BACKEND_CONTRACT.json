    "Project":{"required":["slug","title","category","summary","demoOnly"],"optional":["heroAssetId","challenge","solution","results","technology","galleryAssetIds"],"rules":["demoOnly projects cannot become factual client claims"]},
    "Article":{"required":["slug","title","category","excerpt","content","publishedAt","author"],"optional":["coverAssetId","readMinutes","seoTitle","seoDescription"],"rules":["content must support heading IDs for TOC"]},
    "FAQ":{"required":["id","scope","question","answer","order"]},
    "Lead":{"required":["name","phone","need","service","preferredChannel","consent","sourceRoute","createdAt"],"optional":["email","utm","referrer"],"rules":["phone required","consent required","PII never embedded into analytics event payload"]},
    "Subscriber":{"required":["email","consent","createdAt"],"optional":["sourceRoute"]},
    "SiteSettings":{"required":["brandName","slogan","domain","zalo","telegram"],"optional":["facebookUrl","email","address"]}
