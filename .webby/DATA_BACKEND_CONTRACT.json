  "apiBehavior":{"leadSubmit":{"method":"POST","pathSuggestion":"/api/leads","success":"2xx + stable receipt id","validation":"4xx field errors","serverFailure":"5xx generic user-safe message"},"newsletterSubscribe":{"method":"POST","pathSuggestion":"/api/newsletter","success":"2xx","duplicate":"idempotent success or clear already-subscribed state"}},
